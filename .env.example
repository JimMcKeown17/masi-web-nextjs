# Backend API Configuration
NEXT_PUBLIC_API_URL=https://your-backend-api.com/api

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...

# Clerk URLs (optional, defaults shown)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Google Cloud Storage (optional)
NEXT_PUBLIC_GCS_BUCKET_NAME=masi-website

# Masi Field App dashboard (/operations/field-app)
# Separate Supabase project used only by the Masi React Native mobile app.
# The service role key bypasses RLS and must only be read server-side — never
# import src/lib/masi/* from a client component.
MASI_SUPABASE_URL=https://your-project-ref.supabase.co
MASI_SUPABASE_SERVICE_ROLE_KEY=eyJ_service_role_key_here
